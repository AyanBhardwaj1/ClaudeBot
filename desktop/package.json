{
  "name": "claudebot-desktop",
  "productName": "ClaudeBot",
  "version": "1.3.0",
  "description": "ClaudeBot on your desktop: opens the web app of your own self-hosted ClaudeBot.",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "author": "Ayan Bhardwaj",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.claudebot.desktop",
    "productName": "ClaudeBot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Ayan Bhardwaj"
    },
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AyanBhardwaj1/ClaudeBot.git"
  }
}
