# --- Required ---
# From console.anthropic.com -> API Keys (billed separately from Claude Pro/Max)
ANTHROPIC_API_KEY=
# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Leave empty, message the bot once, and it will tell you.
TELEGRAM_OWNER_ID=

# --- Personal ---
# What ClaudeBot calls you
CLAUDEBOT_OWNER_NAME=sir
CLAUDEBOT_TIMEZONE=America/Chicago
# Daily brief time (24h, local). Leave empty to turn it off.
DAILY_BRIEF_TIME=08:00

# --- Inbox alerts: ClaudeBot pings you when important email arrives ---
INBOX_ALERTS=true
INBOX_CHECK_MINUTES=10
# No alerts during these hours (local time). Leave empty for none.
QUIET_HOURS=23:00-07:00

# --- Sending email ---
# Seconds you have to tap Undo before an email goes out. 0 = send instantly.
UNDO_SEND_SECONDS=20

# --- Spending ---
# Stop all Claude calls once this month's estimated spend reaches this many dollars. Empty = no cap.
MONTHLY_BUDGET_USD=

# --- Group mode ---
# Max answers per group per day (people tag the bot like Grok; this caps your bill)
GROUP_DAILY_LIMIT=30

# --- Optional ---
CLAUDEBOT_MODEL=claude-opus-5-5
# Cheaper model used to sort incoming email for alerts
CLAUDEBOT_FAST_MODEL=claude-haiku-5-5
# low | medium | high: higher = smarter on hard requests, slower and pricier
CLAUDEBOT_EFFORT=medium
# Start a fresh conversation after this many hours of silence (memories carry over)
NEW_THREAD_AFTER_HOURS=8
CLAUDEBOT_DATA_DIR=data
GOOGLE_CREDENTIALS_FILE=credentials.json
# On a server, paste the contents of data/google_token.json here instead of copying the file
GOOGLE_TOKEN_JSON=
